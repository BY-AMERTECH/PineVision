rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isFarmManager() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'farm_manager';
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function ownsBlock(blockData) {
      return signedIn() && blockData.userId == request.auth.uid;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;  // Anyone can read (for username lookup)
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin']));
    }

    // Activity logs collection
    match /activity_logs/{logId} {
      allow read: if request.auth != null;  // Logged-in users can read
      allow create: if true;  // Anyone can create (for login logging)
    }
    
    // Alerts collection - NEW
    match /alerts/{alertId} {
      allow read: if request.auth != null;  // Logged-in users can read alerts
      allow create: if true;  // Anyone can create (for failed login alerts)
      allow update: if request.auth != null;  // Authenticated users can update (mark as resolved)
      allow delete: if request.auth != null;  // Authenticated users can delete
    }
    
    match /blocks/{blockId} {
      allow read: if isFarmManager() || ownsBlock(resource.data);
      allow create: if signedIn() && !isFarmManager() &&
        request.resource.data.userId == request.auth.uid &&
        !request.resource.data.keys().hasAny(['declaredPopulation']);
      allow update: if (isFarmManager() || ownsBlock(resource.data)) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'blockName', 'section', 'area', 'planted', 'forcingDate', 'daf'
        ]);
      allow delete: if ownsBlock(resource.data);
    }

    match /scans/{scanId} {
      allow read: if isFarmManager() || (
        signedIn() && resource.data.userId == request.auth.uid &&
        exists(/databases/$(database)/documents/blocks/$(resource.data.blockId)) &&
        get(/databases/$(database)/documents/blocks/$(resource.data.blockId)).data.userId == request.auth.uid
      );
      // Scan evidence and calculated results are written by the trusted backend.
      allow write: if false;
    }
   
    match /monitoring_alerts/{alertId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
   }
   
    match /missions/{missionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}

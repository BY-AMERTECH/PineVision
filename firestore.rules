rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      allow read: if true;  // Anyone can read (for username lookup)
      allow create: if request.auth != null;  // Authenticated users can create
      allow update: if request.auth != null;  // Authenticated users can update
      allow delete: if request.auth != null;  // Authenticated users can delete
    }

    // Scheduled Scans
    match /scheduled_scans/{docId} {
      allow read, update: if request.auth != null &&
    resource.data.userId == request.auth.uid;
      allow create: if request.auth != null &&
    request.resource.data.userId == request.auth.uid;
    }

    // Activity logs collection
    match /activity_logs/{logId} {
      allow read: if request.auth != null;  // Logged-in users can read
      allow create: if true;  // Anyone can create (for login logging)
    }
    
    // Alerts collection - NEW
    match /alerts/{alertId} {
      allow read: if request.auth != null;  // Logged-in users can read alerts
      allow create: if true;  // Anyone can create (for failed login alerts)
      allow update: if request.auth != null;  // Authenticated users can update (mark as resolved)
      allow delete: if request.auth != null;  // Authenticated users can delete
    }
    
    match /blocks/{blockId} {
      allow read: if request.auth != null;  // ← CHANGED: Allow all logged-in users to read
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
   }

      // Scans collection - ADD THIS NEW SECTION
    match /scans/{scanId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
   }
   
    match /monitoring_alerts/{alertId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
   }
   
    match /missions/{missionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /cropCycles/{cycleId} {
       allow read: if request.auth != null
              && resource.data.userId == request.auth.uid;

       allow create: if request.auth != null
              && request.resource.data.userId == request.auth.uid
              && request.resource.data.blockId is string
              && request.resource.data.status in ['active', 'completed']
              && get(
                   /databases/$(database)/documents/blocks/$(request.resource.data.blockId)
                 ).data.userId == request.auth.uid;

       allow update: if request.auth != null
                && resource.data.userId == request.auth.uid
                && request.resource.data.userId == resource.data.userId
                && request.resource.data.blockId == resource.data.blockId;

       allow delete: if false;
     }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────
    // Helpers: check role from the users collection.
    // ─────────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isFarmManager() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'farm_manager';
    }

    // ─────────────────────────────────────────────────────────
    // users collection
    //
    // Both get and list are allowed for any authenticated user.
    // This is consistent: list already exposes every user's
    // email and profile data to any authenticated caller (needed
    // for the username→email lookup in auth.js).  Restricting
    // get-by-UID to owner/admin would be an inconsistency since
    // the same data is reachable via list.
    // Write still requires admin (Super Admin only).
    // Move lookup to a Cloud Function to tighten read access.
    // ─────────────────────────────────────────────────────────
    match /users/{userId} {
      allow get:   if request.auth != null;
      allow list:  if request.auth != null;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────
    // Per-user farm data: blocks, scans, missions, monitoring_alerts
    //
    // Read/write only if the document's userId matches the caller,
    // OR the caller is an admin (preserves full admin visibility).
    //
    // Farm Managers get read-only, org-wide visibility on blocks,
    // scans and monitoring_alerts (their Dashboard/Blocks/Flights &
    // Scans/Reports pages already query these collections without a
    // userId filter — they're an oversight role across every client).
    // blocks also grants Farm Managers `update` because the Blocks
    // page's Edit-Block action is available to them; no `create`/
    // `delete`, matching what the Farm Manager UI actually offers.
    // ─────────────────────────────────────────────────────────
    match /blocks/{docId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin() || isFarmManager());
      allow update: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin() || isFarmManager());
      allow delete: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
    }

    match /scans/{docId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin() || isFarmManager());
      allow update, delete: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
    }

    match /missions/{docId} {
      allow read, update, delete: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
    }

    match /monitoring_alerts/{docId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin() || isFarmManager());
      allow update, delete: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────
    // scheduled_scans — manual "Schedule Scan" bookings made from a
    // fruit block's detail page. Owner-scoped like blocks/scans/missions
    // above. No delete: cancellation is a status update (status ->
    // 'cancelled') so history is preserved rather than removed.
    //
    // Farm Managers get read-only visibility (their block-detail page
    // shows scheduled scans as an "informational view" — scheduling
    // itself is a client-only action, by design).
    // ─────────────────────────────────────────────────────────
    match /scheduled_scans/{docId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin() || isFarmManager());
      allow update: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────
    // activity_logs and alerts
    //
    // Written by the client SDK including during unauthenticated
    // failed-login attempts (auth.js catch block).  Open create
    // is intentional here.  Admin reads all; users cannot list
    // all logs (prevents enumeration of other users' activity).
    // ─────────────────────────────────────────────────────────
    match /activity_logs/{docId} {
      allow create: if true;
      allow read:   if isAdmin() || isFarmManager();
      allow update, delete: if isAdmin();
    }

    match /alerts/{docId} {
      allow create: if true;
      allow read:   if isAdmin() || isFarmManager();
      allow update, delete: if isAdmin();
    }

  }
}
